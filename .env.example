# Veyra Backend Environment Configuration
FLASK_APP=backend.run:app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# Database Configuration (SQLite default for local dev, Supabase Postgres for staging/prod)
DATABASE_URL=sqlite:///instance/veyra.db
# For Supabase Postgres:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Server & Network Configuration
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Auth & JWT Configuration (Backend verifies access tokens via JWKS)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR_PUBLISHABLE_KEY]
# Service role key (Backend-only, never expose to frontend or log)
SUPABASE_SECRET_KEY=sb_secret_[YOUR_SECRET_KEY]

# Explicit local dev flag (Allows X-User-ID header strictly during offline dev; never enabled in production)
ALLOW_DEV_AUTH_OVERRIDE=false
