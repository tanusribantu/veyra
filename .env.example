# Veyra Backend Environment Configuration
FLASK_APP=backend.run:app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration (SQLite for Prototype, PostgreSQL for MVP)
DATABASE_URL=sqlite:///instance/veyra.db

# Server Configuration
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

